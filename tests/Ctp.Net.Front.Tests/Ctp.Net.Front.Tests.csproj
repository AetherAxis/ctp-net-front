<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 前置主程序集是小写连字符名（ctp-net-front），其 InternalsVisibleTo("ctp-net-front.Tests") 按此匹配 -->
    <AssemblyName>ctp-net-front.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ctp.Net.Front\Ctp.Net.Front.csproj" />
    <!-- FrontLoopback 进程分离回环：交易所 = Exchange 核心 + RPC 宿主 -->
    <ProjectReference Include="..\..\..\aether-exchange\src\Aether.Exchange\Aether.Exchange.csproj" />
    <ProjectReference Include="..\..\..\aether-exchange\src\Aether.Exchange.Rpc\Aether.Exchange.Rpc.csproj" />
    <ProjectReference Include="..\..\..\ctp-net-contracts\src\Ctp.Net.Contracts\Ctp.Net.Contracts.csproj" />
    <!-- 官方 SDK 客户端（CtpTrader/CtpMdUser，P/Invoke）走真实回环，SDK 即裁判 -->
    <ProjectReference Include="..\..\..\ctp-net-core\src\Ctp.Net.Core\Ctp.Net.Core.csproj" />
  </ItemGroup>

  <!-- libctp_native.dylib 的 @rpath 依赖三个 macOS frameworks（thosttraderapi_se/thostmduserapi_se/MacDataCollect）——
       Ctp.Net.Core 的 Content 只带 build/native 的 dylib/so/dll，frameworks 不在其中；
       dyld 载入时全部链接镜像即解析，缺一个就 DllNotFoundError。此处构建后复制到输出目录
       （cp -R 保留 frameworks 的 Versions/A symlink 结构；重复执行为幂等合并覆盖）。 -->
  <PropertyGroup>
    <CtpSdkDir>$(MSBuildThisFileDirectory)../../../ctp-net-core/ctp-sdk/macos-universal</CtpSdkDir>
  </PropertyGroup>
  <Target Name="CopyCtpMacFrameworks" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Message Importance="high" Text="复制 CTP macOS frameworks → $(OutDir)" />
    <Exec Command='cp -R "$(CtpSdkDir)/thosttraderapi_se.framework" "$(OutDir)"' />
    <Exec Command='cp -R "$(CtpSdkDir)/thostmduserapi_se.framework" "$(OutDir)"' />
    <Exec Command='cp -R "$(CtpSdkDir)/MacDataCollect.framework" "$(OutDir)"' />
  </Target>

</Project>
